APP_ENV=development
FRONTEND_URL=http://localhost:5173
BACKEND_URL=http://localhost:8000
CORS_ORIGINS=http://localhost:5173
DATABASE_URL=sqlite:///./merchant_audit.db

# Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=replace-with-at-least-32-random-characters
SESSION_COOKIE_NAME=merchant_audit_session
SESSION_DAYS=14
COOKIE_SECURE=false
COOKIE_SAMESITE=lax

# Google Cloud OAuth 2.0 Web application credentials.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:8000/api/auth/google/callback

# One-time Merchant API developer registration. Enable only for the setup login
# by an Admin directly added to this verified primary Merchant Center account,
# then set GOOGLE_REGISTER_PROJECT_ON_LOGIN=false and redeploy.
GOOGLE_REGISTER_PROJECT_ON_LOGIN=false
GOOGLE_DEVELOPER_MERCHANT_ID=
GOOGLE_DEVELOPER_EMAIL=

# Optional UI integrations. Their endpoints return an explicit configuration error if absent.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-6-astra
RESEND_API_KEY=
RESEND_FROM_EMAIL=MerchantAudit <audit@your-verified-domain.com>
RESEND_TO_EMAIL=team@your-domain.com

AUDIT_MAX_PRODUCTS=20000
WEBSITE_AUDIT_MAX_PAGES=25
REQUEST_TIMEOUT_SECONDS=30

